{
  "name": "pokaimon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint src tests vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dev:agent": "tsx server/start.ts",
    "test:agui": "vitest run tests/agui.test.ts",
    "models:scan": "node scripts/evolve-models.mjs --live",
    "models:validate": "node scripts/evolve-models.mjs --validate-only"
  },
  "dependencies": {
    "phaser": "4.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@ag-ui/client": "1.0.5",
    "@ag-ui/core": "1.0.5",
    "@ag-ui/encoder": "1.0.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.3.8",
    "vitest": "^4.0.0",
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0"
  }
}
